ANTHROPIC_API_KEY=
# Model names (override freely)
MODEL_EXTRACT=claude-sonnet-5-5
MODEL_ASK=claude-sonnet-5-5
MODEL_REDLINE=claude-sonnet-5-5

POSTGRES_USER=vmo
POSTGRES_PASSWORD=vmo
POSTGRES_DB=vmo
DATABASE_URL=postgresql+psycopg://vmo:vmo@db:5432/vmo
# Read-only role used by the Ask assistant's run_sql tool (created by migration 0001)
READONLY_DATABASE_URL=postgresql+psycopg://vmo_readonly:vmo_readonly@db:5432/vmo

# Embeddings: "local" (sentence-transformers, 384-dim) or "hosted"
EMBEDDING_PROVIDER=auto  # auto | local | hash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
